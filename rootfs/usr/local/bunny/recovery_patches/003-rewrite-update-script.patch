+check_md5sum() {
+    # $1: Filename (kernelname, rootfsname, etc)
+    filesum=`md5sum $updatefolder/$1 | cut -d' ' -f1`
+    
+    # Get the stored md5sum from the upgrade/recovery directory.
+    if [ -f $updatefolder/$1.md5 ]; then
+        md5string=`cat $updatefolder/$1.md5 | cut -d' ' -f1`
+    else
+        echo "--- Fatal Error: MD5Sum file not found in tar."
+        echo "=== $(date +%D_%T) Update Log: Fatal Error: MD5Sum file not found." >> /root/update.log
+        do_exit
+    fi
+
+    # Check if the md5 of our file and the stored md5 do not match.
+    if [ "$md5string" != "$filesum" ]; then
+        echo "--- Fatal Error: MD5 hashes do not match. File Sum = ${filesum}, Stored Sum = ${md5string}"
+        echo "=== $(date +%D_%T) Update Log: Fatal Error: MD5 hashes do not match. File Sum = ${filesum}, Stored Sum = ${md5string}" >> /root/update.log
+        echo "=== $(date +%D_%T) Update Log: Deleting file ${entry}" >> /root/update.log        
+        rm -rf "$sourcefolder/$entry"
+        echo ""
+        echo "--- Exiting ..."
+        echo 1 > $bootcountfolder/tar_fail.txt
+        do_exit
+    fi
+}
