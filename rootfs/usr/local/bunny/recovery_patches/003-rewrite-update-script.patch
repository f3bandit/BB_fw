+        echo "=== $(date +%D_%T) Update Log: No update file found." >> /root/update.log
+        do_exit
+    fi
+
+    if [ -d "$sourcefolder/$entry" ]; then
+        echo "--- Found an incorrect entry (folder). Removing $entry ..."
+        rm -rf "$sourcefolder/$entry"
+        echo "--- Writing error log to $sourcepartition/update.log"
+        echo "=== $(date +%D_%T) Update Log: Update did not occur, incorrect file or folder ($entry) removed." >> /root/update.log
+        do_exit
+    fi
+
+    lenMatch=`expr match "$entry" "$startString"`
+    echo "--- Entry is ${entry}, startString = ${startString}, lenString = ${lenString}, lenMatch = ${lenMatch}"
+    echo "=== $(date +%D_%T) Update Log: Entry is ${entry}, startString = ${startString}, lenString = ${lenString}, lenMatch = ${lenMatch}" >> /root/update.log
+
+    if [ $lenMatch -eq $lenString ]; then
+        updateFileFound=1
+        break
+    fi
+
+    if [ $updateFileFound -eq 0 ]; then
+        echo "--- No update file was found. Exiting ..."
+        echo "=== $(date +%D_%T) Update Log: No update file was found." >> /root/update.log
+        echo 1 > $bootcountfolder/tar_fail.txt
+        do_exit
+    else
+        echo "--- Found update file! Using ${entry} ..."
+        echo "=== $(date +%D_%T) Update Log: Update file used is ${entry}" >> /root/update.log
+    fi  
+}
+
+########################################################################
+# Stage 3: Untar update file and verify md5sum.
+########################################################################
+
+updatefolder=$cachefolder/update
+kernelname="uImage"
+rootfsname="cherry.rootfs.tar"
+initrdname="cherry.initrd.tar"
+ifcversion="cherry-version"
+
+check_md5sum() {
+    # $1: Filename (kernelname, rootfsname, etc)
+    filesum=`md5sum $updatefolder/$1 | cut -d' ' -f1`
+    
+    # Get the stored md5sum from the upgrade/recovery directory.
+    if [ -f $updatefolder/$1.md5 ]; then
+        md5string=`cat $updatefolder/$1.md5 | cut -d' ' -f1`
+    else
+        echo "--- Fatal Error: MD5Sum file not found in tar."
+        echo "=== $(date +%D_%T) Update Log: Fatal Error: MD5Sum file not found." >> /root/update.log
+        do_exit
+    fi
+
+    # Check if the md5 of our file and the stored md5 do not match.
+    if [ "$md5string" != "$filesum" ]; then
+        echo "--- Fatal Error: MD5 hashes do not match. File Sum = ${filesum}, Stored Sum = ${md5string}"
+        echo "=== $(date +%D_%T) Update Log: Fatal Error: MD5 hashes do not match. File Sum = ${filesum}, Stored Sum = ${md5string}" >> /root/update.log
+        echo "=== $(date +%D_%T) Update Log: Deleting file ${entry}" >> /root/update.log        
+        rm -rf "$sourcefolder/$entry"
+        echo ""
+        echo "--- Exiting ..."
+        echo 1 > $bootcountfolder/tar_fail.txt
+        do_exit
+    fi
+}
+
+format_cache_partiion() {
+    echo
+    echo "--- Formatting Cache Partition ($cachepartition) ..."
+    /sbin/mkfs.ext4 -F $cachepartition
+    mount -t ext4 $cachepartition $cachefolder
+}
+
+untar_and_verify() {
+    echo 
+    echo "--- Stage 3: Extracting update and verifying integrity in $updatefolder ..."
+    echo "=== $(date +%D_%T) Update Log: Starting Stage 3" >> /root/update.log
+    format_cache_partiion
+
+    mkdir -p "$updatefolder"
+    cd "$updatefolder"
+
+    echo "--- Extracting $sourcefolder/$entry ..."
+    tar -xzf "$sourcefolder/$entry"
+    if [ $? -ne 0 ]; then
+        echo '--- Cannot extract this file. Is it really a .tar.gz?'
+        echo "=== $(date +%D_%T) Update Log: Fatal Error: Could not extract the file ${entry}" >> /root/update.log
+        echo "=== $(date +%D_%T) Update Log: Deleting file ${entry}" >> /root/update.log
+        rm -rf "$sourcefolder/$entry"
+        do_exit
+    fi
+
+    cd "$updatefolder/upgrade"
+    mv * ../
+    cd ../
+    rmdir upgrade
+
+    echo "--- Checking file integrity ..."
+    check_md5sum $kernelname
+    check_md5sum $rootfsname
+}
+
+########################################################################
+# Stage 4: Update rootfs
+########################################################################
+
+format_dest_partition() {
+    echo "--- Formatting destination partition $destpartition ..."
+    /sbin/mkfs.ext4 -F $destpartition
+    mount -t ext4 $destpartition $destfolder
 }
 
+do_update_rootfs() {
+    echo
+    echo "--- Stage 4: Updating rootfs ..."
+    echo "=== $(date +%D_%T) Update Log: Starting Stage 4" >> /root/update.log
+    format_dest_partition
+
+    echo "--- Update rootfs to destination partition ..."
+    cd "$destfolder"
+    tar -xf "$updatefolder/$rootfsname"
+    cd "$destfolder/rootfs"
+    mv * ../
+    cd .. && rmdir rootfs
+    cd
+}
+
+########################################################################
+# Stage 5: Update kernel
+########################################################################
+
+do_update_kernel() {
+    echo
+    echo "--- Stage 5: Updating the kernel ..."
+    echo "=== $(date +%D_%T) Update Log: Starting Stage 5" >> /root/update.log
+    dd if=$updatefolder/uImage of=$kernelpartition bs=256k
+}
+
+########################################################################
+# Stage 6: Post-Update (Copy User Data)
+########################################################################
+
+ret_post_update=0
+ret_post_update_filename="/tmp/ret_post_update"
+post_update_file=$destfolder/root/do_post_update.sh
+
+do_copy_user_data() {
+    echo
+    echo "--- Stage 6: Post Update ..."
+
+    if [ -f $post_update_file ]; then
+        echo "--- Running do_post_update.sh"
+        $post_update_file
+    else
+        echo "--- There is no post update script."
+    fi
+
+    if [ -f $ret_post_update_filename ]; then
+        ret_post_update=`cat $ret_post_update_filename`
+        if [ $ret_post_update -ne 1 ]; then
+            echo "--- Fatal Error: Post update failure."
+            echo "=== $(date +%D_%T) Update Log:  Fatal Error: Post update failure." >> /root/update.log
+            do_exit
+        fi
+    fi
+}
+
+########################################################################
+# Stage 7: Remove intermediate update files.
+########################################################################
+
+do_remove_files() {
+    echo
+    echo "--- Stage 7: Remove intermediate update files ..."
+    echo "=== $(date +%D_%T) Update Log: Starting Stage 7" >> /root/update.log
+    rm -f "$ret_post_update_filename"
+
+    case $purpose in
+        upgrade)
+            rm "$sourcefolder/$entry"
+            echo "--- Upgrade complete. Notifying u-boot ..."
+            echo 1 > "$bootcountfolder/tar_fail.txt"
+            ;;
+    esac
+}
+
+########################################################################
+# Magic
+########################################################################
 
 do_mount_upgrade
 check_updatefile
-unzip_and_check_integrity
+untar_and_verify
 do_update_rootfs
-do_update_kernel_dtb
+do_update_kernel
 do_copy_user_data
-check_and_update_uboot
 do_remove_files
 do_unmount
 
-
 echo
-echo "--- Done."
+echo
+echo "--- Script completed."
+echo "=== $(date +%D_%T) Update Log: Updater has completed." >> /root/update.log
 exit 0
